F_util <- c("T4", "T5", "T6")
F_conf <- c("T7", "T8", "T9")
s_j <- sapply(results_df[metrics], sd, na.rm = TRUE)
loss_matrix <- sweep(results_df[metrics], 2, T_star, FUN = "-")
loss_matrix <- sweep(loss_matrix^2, 2, s_j^2, FUN = "/")
results_df$L_fid  <- rowMeans(loss_matrix[, F_fid],  na.rm = TRUE)
results_df$L_util <- rowMeans(loss_matrix[, F_util], na.rm = TRUE)
results_df$L_conf <- rowMeans(loss_matrix[, F_conf], na.rm = TRUE)
# Poids (modifiable)
w_fid  <- 1/3
w_util <- 1/3
w_conf <- 1/3
results_df$L_total <-
w_fid  * results_df$L_fid +
w_util * results_df$L_util +
w_conf * results_df$L_conf
# ============================================================
# 5. Sélection du meilleur jeu synthétique
