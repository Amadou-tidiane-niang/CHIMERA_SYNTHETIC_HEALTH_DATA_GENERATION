best_index <- which.min(results_df$L_total)
best_dataset <- results_df[best_index, ]
# Save original dataset
write.csv(best_dataset, here(paste(chemin,"AIDS",sep="/"), "best_dataset_CTGAN.csv"), row.names = FALSE)
