T3 = T[3],
T4 = T[4],
T5 = T[5],
T6 = T[6],
T7 = T[7],
T8 = T[8],
T9 = T[9]
)
})
# Combiner en un seul data.frame
results_df <- do.call(rbind, results)
row.names(results_df) <- NULL
# la fonction de minimisation
# Colonnes des métriques
metrics <- paste0("T", 1:9)
T_star <- c(
T1 = 0,
T2 = 0,
T3 = 0.5,
T4 = 0,
T5 = 0,
T6 = 0,
T7 = 1,
T8 = 0.5,
T9 = 0
)
F_fid  <- c("T1", "T2", "T3")
F_util <- c("T4", "T5", "T6")
F_conf <- c("T7", "T8", "T9")
s_j <- sapply(results_df[metrics], sd, na.rm = TRUE)
loss_matrix <- sweep(results_df[metrics], 2, T_star, FUN = "-")
loss_matrix <- sweep(loss_matrix^2, 2, s_j^2, FUN = "/")
results_df$L_fid  <- rowMeans(loss_matrix[, F_fid],  na.rm = TRUE)
results_df$L_util <- rowMeans(loss_matrix[, F_util], na.rm = TRUE)
results_df$L_conf <- rowMeans(loss_matrix[, F_conf], na.rm = TRUE)
# Poids (modifiable)
w_fid  <- 1/3
w_util <- 1/3
w_conf <- 1/3
results_df$L_total <-
w_fid  * results_df$L_fid +
w_util * results_df$L_util +
w_conf * results_df$L_conf
# ============================================================
# 5. Sélection du meilleur jeu synthétique
# ============================================================
best_index <- which.min(results_df$L_total)
best_dataset <- results_df[best_index, ]
# Save original dataset
write.csv(best_dataset, here(paste(chemin,"AIDS",sep="/"), "best_dataset_SYNTHPOP.csv"), row.names = FALSE)
# jeu de données synthétiques avec CHIMERA
AIDS_SYNTHPOP <- synthetic_data_list[[23]]  # seed = 57
# Save original dataset
write.csv(AIDS_SYNTHPOP, here(paste(chemin,"AIDS",sep="/"), "AIDS_SYNTHPOP.csv"), row.names = FALSE)
stats_T <- results_df |>
summarise(across(
T1:T9,
list(
median = median,
q25  = ~ quantile(.x, 0.25),
q75  = ~ quantile(.x, 0.75)
),
.names = "{.col}_{.fn}"
))
# Format long
results_long <- results_df |>
pivot_longer(
cols = T1:T9,
names_to = "Metric",
values_to = "Value"
)
stats_long <- stats_T |>
pivot_longer(
everything(),
names_to = c("Metric", ".value"),
names_sep = "_"
)
best_long <- best_dataset |>
select(T1:T9) |>
pivot_longer(
everything(),
names_to = "Metric",
values_to = "best_value"
)
metric_labels <- c(
T1 = "T1 – Divergence de Jensen--Shannon (JSD)",
T2 = "T2 – Correlation Frobenius Distance (CFD)",
T3 = "T3 – Discrimination (AUC)",
T4 = "T4 – Standardized Difference",
T5 = "T5 – ΔAUC (TSTR)",
T6 = "T6 – ΔAUC (TSRTR)",
T7 = "T7 – Membership Inference Risk ",
T8 = "T8 – Membership Inference Risk (Holdout set)",
T9 = "T9 – Attribute Inference Risk (AIR)"
)
results_long$Metric <- factor(
results_long$Metric,
levels = names(metric_labels),
labels = metric_labels
)
stats_long$Metric <- factor(
stats_long$Metric,
levels = names(metric_labels),
labels = metric_labels
)
best_long$Metric <- factor(
best_long$Metric,
levels = names(metric_labels),
labels = metric_labels
)
plt <-ggplot(results_long, aes(x = Value)) +
geom_density(
fill = "steelblue",
alpha = 0.25,
color = "black"
) +
geom_vline(
data = stats_long,
aes(xintercept = median),
color = "red",
linewidth = 1
) +
geom_vline(
data = stats_long,
aes(xintercept = q25),
linetype = "dashed",
color = "black"
) +
geom_vline(
data = stats_long,
aes(xintercept = q75),
linetype = "dashed",
color = "black"
) +
geom_vline(
data = best_long,
aes(xintercept = best_value),
color = "darkgreen",
linewidth = 1.2
) +
facet_wrap(~ Metric, scales = "free") +
theme_minimal(base_size = 12) +
labs(
title = "Distribution of Synthetic Data Evaluation Metrics| SYNTHPOP",
subtitle = "Based on 50 generated synthetic datasets | Red = median | Black dashed = Q25–Q75 | Green = optimal synthetic dataset",
x = "Value",
y = "Density"
)
plt
#save
ggsave(filename = here(paste(chemin,"AIDS",sep="/"), paste0("metrics_distributions_aids_synth", ".eps")),plot = plt,width = 12, height = 8, units = "in",device = cairo_ps,fallback_resolution = 600)
# CT-GAN------------------------------------------------------------------------------------
# Dossier contenant les fichiers
data_dir <- "~/Bureau/ARTICLES_GENERATIONS_DONNEES_SYNTHETIQUES_PHASE_2/results/AIDS/synthetic_datasets"
files <- sprintf(
"%s/AIDS_CTGAN_%02d.csv",
data_dir,
1:50
)
synthetic_data_list <- vector("list", length(files))
synthetic_data_list <- lapply(files, read_csv, show_col_types = FALSE)
# Appliquer la fonction à chaque jeu synthétique
results <- lapply(seq_along(synthetic_data_list), function(m) {
T <- Assessment_function_FUP(
X_real = X_real,
X_syn  = as.data.frame(synthetic_data_list[[m]]),
S = 5,
seed = 123,
formula = Surv(times, Censored) ~ .,
modeling = "cox",
time_var = "times",
event_var = "Censored",
survival_data = TRUE,
pct_missing = 0.15,
target_col = "Homosexuality",
feature_associate=feature_associate
)
data.frame(
dataset = paste0("syn_", m),
T1 = T[1],
T2 = T[2],
T3 = T[3],
T4 = T[4],
T5 = T[5],
T6 = T[6],
T7 = T[7],
T8 = T[8],
T9 = T[9]
)
})
# Combiner en un seul data.frame
results_df <- do.call(rbind, results)
row.names(results_df) <- NULL
# la fonction de minimisation
# Colonnes des métriques
